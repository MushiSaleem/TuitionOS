# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only; never prefix with VITE_).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Client Deployment Configuration (A1 White-Glove Configuration Foundation)
# ---------------------------------------------------------------------------
# Path to the academy's validated client.config.json (never auto-selects clients/example/client.config.json).
# Omit in local development to use the built-in TuitionOS development/demo defaults.
# CLIENT_CONFIG_PATH="clients/<academy-slug>/client.config.json"

# Set to "true" in production academy CI/CD to fail builds if CLIENT_CONFIG_PATH is omitted.
# REQUIRE_CLIENT_CONFIG="false"

# Optional override for modules.demoSandboxEnabled ("true" or "false").
# VITE_DEMO_SANDBOX_ENABLED="false"

# ---------------------------------------------------------------------------
# Firebase Web Client Configuration (Public Client SDK Config Only)
# Never put Firebase Admin SDK service-account credentials or private secrets in VITE_* vars.
# Production builds MUST provide these variables and never fall back to firebase-applet-config.json.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
# Optional: named Firestore database ID (omit to use "(default)")
VITE_FIREBASE_DATABASE_ID="(default)"
# Optional: Google Analytics Measurement ID
# VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Development-only transition fallback toggle (ignored in production builds).
# Set to "false" to verify missing-config failure behavior locally in dev mode.
# VITE_ALLOW_DEV_FIREBASE_FALLBACK="true"

# Set to "true" in CI/CD production builds to enforce VITE_FIREBASE_* presence at build time as well as startup.
# STRICT_FIREBASE_ENV="true"
