{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account linked to a platform or institute role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "institute_admin", "receptionist", "lecturer", "student"] },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "linkedEntityId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "instituteId", "status", "createdAt", "updatedAt"]
    },
    "Institute": {
      "title": "Institute",
      "description": "Multi-tenant Sri Lankan tuition institute or academy",
      "type": "object",
      "properties": {
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "city": { "type": "string", "minLength": 2, "maxLength": 60 },
        "district": { "type": "string", "minLength": 2, "maxLength": 60 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "subscriptionTier": { "type": "string", "enum": ["starter", "pro", "enterprise"] },
        "monthlyFeeLkr": { "type": "number" },
        "billingStatus": { "type": "string", "enum": ["paid", "pending", "overdue"] },
        "activeStudentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["instituteId", "name", "city", "district", "phone", "email", "ownerUid", "ownerName", "status", "subscriptionTier", "monthlyFeeLkr", "billingStatus", "activeStudentCount", "createdAt", "updatedAt"]
    },
    "OnboardingRequest": {
      "title": "OnboardingRequest",
      "description": "Public institute onboarding inquiry submitted from the TuitionOS landing page",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "city": { "type": "string", "minLength": 2, "maxLength": 60 },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "estimatedStudents": { "type": "number" },
        "preferredTier": { "type": "string", "enum": ["starter", "pro", "enterprise"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "instituteName", "city", "ownerName", "email", "phone", "estimatedStudents", "preferredTier", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Platform-wide audit log for Super Admin actions",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["institute", "onboarding", "billing", "system"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "actorUid", "actorEmail", "action", "targetType", "targetId", "summary", "createdAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Institute staff member (lecturer, receptionist, or admin)",
      "type": "object",
      "properties": {
        "staffId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "nic": { "type": "string", "minLength": 10, "maxLength": 12 },
        "role": { "type": "string", "enum": ["institute_admin", "receptionist", "lecturer"] },
        "subjectSpecialty": { "type": "string", "maxLength": 80 },
        "defaultSharePct": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "instituteId", "fullName", "email", "phone", "nic", "role", "defaultSharePct", "status", "createdAt", "updatedAt"]
    },
    "TuitionClass": {
      "title": "TuitionClass",
      "description": "Subject class within an institute with Sri Lankan academic stream and revenue share",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 60 },
        "grade": { "type": "string", "maxLength": 30 },
        "stream": { "type": "string", "maxLength": 40 },
        "medium": { "type": "string", "enum": ["Sinhala", "English", "Tamil"] },
        "classType": { "type": "string", "enum": ["Theory", "Revision", "Paper Class"] },
        "lecturerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lecturerName": { "type": "string", "maxLength": 100 },
        "lecturerSharePct": { "type": "number" },
        "monthlyFeeLkr": { "type": "number" },
        "admissionFeeLkr": { "type": "number" },
        "hallName": { "type": "string", "maxLength": 60 },
        "scheduleDay": { "type": "string", "maxLength": 20 },
        "scheduleTime": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "instituteId", "title", "subject", "grade", "stream", "medium", "classType", "lecturerId", "lecturerName", "lecturerSharePct", "monthlyFeeLkr", "admissionFeeLkr", "hallName", "scheduleDay", "scheduleTime", "status", "createdAt", "updatedAt"]
    },
    "ClassBatch": {
      "title": "ClassBatch",
      "description": "Timetable batch and classroom capacity allocation",
      "type": "object",
      "properties": {
        "batchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 120 },
        "batchCode": { "type": "string", "maxLength": 30 },
        "academicYear": { "type": "string", "maxLength": 10 },
        "hallName": { "type": "string", "maxLength": 60 },
        "dayOfWeek": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "capacity": { "type": "number" },
        "enrolledCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "full", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["batchId", "instituteId", "classId", "className", "batchCode", "academicYear", "hallName", "dayOfWeek", "startTime", "endTime", "capacity", "enrolledCount", "status", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled student within a specific tuition institute",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentCode": { "type": "string", "maxLength": 24, "pattern": "^STU-[0-9]{4}-[0-9]{4}$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "nic": { "type": "string", "maxLength": 12 },
        "phone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "parentName": { "type": "string", "maxLength": 100 },
        "parentPhone": { "type": "string", "minLength": 9, "maxLength": 20 },
        "school": { "type": "string", "maxLength": 100 },
        "grade": { "type": "string", "maxLength": 30 },
        "stream": { "type": "string", "maxLength": 40 },
        "medium": { "type": "string", "enum": ["Sinhala", "English", "Tamil"] },
        "enrolledClassIds": { "type": "array" },
        "cardTier": { "type": "string", "enum": ["full", "half", "free"] },
        "admissionPaid": { "type": "boolean" },
        "portalPin": { "type": "string", "minLength": 4, "maxLength": 8 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "instituteId", "studentCode", "fullName", "phone", "parentPhone", "grade", "stream", "medium", "enrolledClassIds", "cardTier", "admissionPaid", "portalPin", "status", "createdAt", "updatedAt"]
    },
    "FeePayment": {
      "title": "FeePayment",
      "description": "Monthly class card and admission fee payment ledger entry in LKR",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNo": { "type": "string", "maxLength": 40 },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 120 },
        "lecturerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lecturerName": { "type": "string", "maxLength": 100 },
        "monthKey": { "type": "string", "maxLength": 12, "pattern": "^([0-9]{4}-[0-9]{2}|ADMISSION)$" },
        "monthLabel": { "type": "string", "maxLength": 30 },
        "cardTier": { "type": "string", "enum": ["full", "half", "free", "admission"] },
        "amountLkr": { "type": "number" },
        "lecturerShareLkr": { "type": "number" },
        "instituteShareLkr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "bank_transfer"] },
        "collectedByUid": { "type": "string", "maxLength": 128 },
        "collectedByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "instituteId", "receiptNo", "studentId", "studentCode", "studentName", "classId", "className", "lecturerId", "lecturerName", "monthKey", "monthLabel", "cardTier", "amountLkr", "lecturerShareLkr", "instituteShareLkr", "paymentMethod", "collectedByUid", "collectedByName", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Quick check-in attendance log for a student in a class",
      "type": "object",
      "properties": {
        "attendanceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 120 },
        "dateKey": { "type": "string", "maxLength": 12 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "feeStatus": { "type": "string", "enum": ["paid", "overdue", "half_card", "free_card"] },
        "arrearsLkr": { "type": "number" },
        "checkedInByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["attendanceId", "instituteId", "studentId", "studentCode", "studentName", "classId", "className", "dateKey", "monthKey", "feeStatus", "arrearsLkr", "checkedInByUid", "createdAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Paper test or term exam created for a tuition class",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 120 },
        "lecturerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examDate": { "type": "string", "maxLength": 12 },
        "maxMarks": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "instituteId", "title", "classId", "className", "lecturerId", "examDate", "maxMarks", "createdAt", "updatedAt"]
    },
    "ExamMark": {
      "title": "ExamMark",
      "description": "Individual student score and grade for a paper test",
      "type": "object",
      "properties": {
        "markId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examTitle": { "type": "string", "maxLength": 120 },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 100 },
        "marksObtained": { "type": "number" },
        "maxMarks": { "type": "number" },
        "grade": { "type": "string", "enum": ["A", "B", "C", "S", "W"] },
        "enteredByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["markId", "instituteId", "examId", "examTitle", "classId", "studentId", "studentCode", "studentName", "marksObtained", "maxMarks", "grade", "enteredByUid", "createdAt", "updatedAt"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Tute, PDF note, past paper, or recorded lecture link uploaded by a lecturer",
      "type": "object",
      "properties": {
        "materialId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "maxLength": 120 },
        "lecturerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lecturerName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "materialType": { "type": "string", "enum": ["PDF Notes", "Past Paper", "Tute", "Video Link"] },
        "url": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["materialId", "instituteId", "classId", "className", "lecturerId", "lecturerName", "title", "materialType", "url", "createdAt", "updatedAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Pre-authorized role and tenant invite keyed by lowercase email",
      "type": "object",
      "properties": {
        "inviteEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["institute_admin", "receptionist", "lecturer", "student"] },
        "instituteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "linkedEntityId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteEmail", "role", "instituteId", "displayName", "status", "createdByUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User role and tenant mapping profile"
    },
    "/invites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Pre-authorized email-to-role tenant invitations"
    },
    "/institutes/{instituteId}": {
      "schema": { "$ref": "#/entities/Institute" },
      "description": "Root multi-tenant institute record"
    },
    "/onboardingRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OnboardingRequest" },
      "description": "Institute onboarding applications from landing page"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Super Admin platform audit trail"
    },
    "/institutes/{instituteId}/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Institute lecturers, receptionists, and admins"
    },
    "/institutes/{instituteId}/classes/{classId}": {
      "schema": { "$ref": "#/entities/TuitionClass" },
      "description": "Tuition subject classes within an institute"
    },
    "/institutes/{instituteId}/batches/{batchId}": {
      "schema": { "$ref": "#/entities/ClassBatch" },
      "description": "Timetable batches for classes"
    },
    "/institutes/{instituteId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Enrolled students scoped to institute"
    },
    "/institutes/{instituteId}/feePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/FeePayment" },
      "description": "Monthly class card and admission fee receipts"
    },
    "/institutes/{instituteId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Quick check-in attendance logs"
    },
    "/institutes/{instituteId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Paper tests and term exams"
    },
    "/institutes/{instituteId}/examMarks/{markId}": {
      "schema": { "$ref": "#/entities/ExamMark" },
      "description": "Individual student exam marks"
    },
    "/institutes/{instituteId}/studyMaterials/{materialId}": {
      "schema": { "$ref": "#/entities/StudyMaterial" },
      "description": "Lecturer study materials and PDF links"
    }
  }
}
